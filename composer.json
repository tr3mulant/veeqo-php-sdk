{
    "name": "tremulanttech/veeqo-php-sdk",
    "description": "PHP SDK for the Veeqo API, built on Saloon, with Laravel auto-discovery.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "cuyz/valinor": "^2.0",
        "saloonphp/pagination-plugin": "^2.3",
        "saloonphp/rate-limit-plugin": "^2.5",
        "saloonphp/saloon": "^4.0"
    },
    "require-dev": {
        "illuminate/support": "^12.0 || ^13.0",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.2",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "TremulantTech\\Veeqo\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TremulantTech\\Veeqo\\VeeqoServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
