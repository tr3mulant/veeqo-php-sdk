{
    "name": "irongateenterprises/veeqo-php-sdk",
    "description": "PHP SDK for the Veeqo API, built on Saloon, with Laravel auto-discovery.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "saloonphp/saloon": "^4.0",
        "saloonphp/pagination-plugin": "^2.3"
    },
    "require-dev": {
        "pestphp/pest": "^5.2"
    },
    "autoload": {
        "psr-4": {
            "IronGate\\Veeqo\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "IronGate\\Veeqo\\VeeqoServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
