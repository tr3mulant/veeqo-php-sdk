{
    "source": {
        "method": "POST",
        "path": "/shipping/shipments",
        "operation": "https://developers.veeqo.com/api/operations/purchase-shipping-labels/"
    },
    "status": 200,
    "headers": {
        "content-type": "application/json"
    },
    "body": {
        "id": 123456789,
        "outbound_label_charges": {
            "unit": "USD",
            "value": "8.56,"
        },
        "tracking_url": "<TRACKING_URL>",
        "label_url": "<LABEL_URL_PART_FROM_PURCHASE>"
    }
}
